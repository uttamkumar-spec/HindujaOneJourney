# Copy to backend/.env.dev and fill in. backend/.env.dev is gitignored — never commit real values.

# development | production. AUTH_MODE=dev is refused unless this is development.
APP_ENV=development
# 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-chars
# supabase | ad | dev
AUTH_MODE=dev
# portal,admin (both) — or run two instances: portal-only (public) and admin-only (internal)
SERVE_SURFACES=portal,admin
# false only for local http://; keep true behind HTTPS
COOKIE_SECURE=false
DATABASE_PATH=instance/hoj.sqlite3

# ---- Option 1: Supabase -----------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon"/publishable key — safe to expose to browsers
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only for older projects that still sign with the HS256 JWT secret; leave empty for asymmetric keys (JWKS)
SUPABASE_JWT_SECRET=
# Users whose app_metadata.role equals this value can open the admin console
SUPABASE_ADMIN_ROLE=admin

# ---- Option 2: Active Directory (LDAP) --------------------------------------
LDAP_URL=ldaps://dc01.corp.example.com:636
# Appended to plain usernames to form the UPN used for the bind
LDAP_UPN_SUFFIX=@corp.example.com
LDAP_BASE_DN=DC=corp,DC=example,DC=com
LDAP_ADMIN_GROUP_DN=CN=HOJ-Admins,OU=Groups,DC=corp,DC=example,DC=com
# Optional: only members of this group may use the customer portal
LDAP_PORTAL_GROUP_DN=
# Optional: CA bundle that signed the domain controller's certificate
LDAP_CA_CERT_FILE=
LDAP_TIMEOUT=5

# ---- dev mode only (AUTH_MODE=dev) -----------------------------------------
# username:password:role (role = admin or user), comma separated
DEV_USERS=employee:change-me-employee:user,admin:change-me-admin:admin
